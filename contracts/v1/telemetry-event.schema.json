{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nddev.ai/schemas/nddev-device-sync/v1/telemetry-event.schema.json",
  "title": "Redacted telemetry event",
  "type": "object",
  "required": ["timestamp", "severity", "service_name", "event_name"],
  "properties": {
    "timestamp": {"type":"string","format":"date-time"},
    "severity": {"enum":["trace","debug","info","warn","error","fatal"]},
    "service_name": {"type":"string","minLength":1,"maxLength":128},
    "service_version": {"type":"string","maxLength":128},
    "device_id": {"type":"string","maxLength":128},
    "server_id": {"type":"string","maxLength":128},
    "module": {"type":"string","maxLength":128},
    "event_name": {"type":"string","minLength":1,"maxLength":256},
    "trace_id": {"type":"string","maxLength":128},
    "span_id": {"type":"string","maxLength":128},
    "attributes": {"type":"object","additionalProperties":true},
    "redaction_version": {"type":"integer","minimum":1}
  },
  "additionalProperties": false
}

