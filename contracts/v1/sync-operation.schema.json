{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nddev.ai/schemas/nddev-device-sync/v1/sync-operation.schema.json",
  "title": "Sync operation",
  "type": "object",
  "required": ["operation_id", "device_id", "entity_type", "entity_id", "base_revision", "idempotency_key", "payload"],
  "properties": {
    "operation_id": {"type":"string","minLength":1,"maxLength":128},
    "device_id": {"type":"string","minLength":1,"maxLength":128},
    "entity_type": {"type":"string","minLength":1,"maxLength":128},
    "entity_id": {"type":"string","minLength":1,"maxLength":256},
    "base_revision": {"type":"integer","minimum":0},
    "idempotency_key": {"type":"string","minLength":1,"maxLength":256},
    "schema_version": {"type":"integer","minimum":1},
    "payload": {"type":"object"}
  },
  "additionalProperties": false
}

