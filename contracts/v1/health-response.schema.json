{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nddev.ai/schemas/nddev-device-sync/v1/health-response.schema.json",
  "title": "HealthResponse",
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "const": "ok"
    },
    "service": {
      "type": "string",
      "const": "nddev-device-sync-server"
    },
    "version": {
      "type": "string"
    },
    "channel": {
      "type": "string"
    },
    "standards_release": {
      "type": "string"
    },
    "source_commit": {
      "type": "string"
    },
    "module_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "telemetry_enabled": {
      "type": "boolean"
    },
    "database_configured": {
      "type": "boolean"
    }
  },
  "required": [
    "status",
    "service",
    "version",
    "channel",
    "standards_release",
    "source_commit",
    "module_count",
    "telemetry_enabled",
    "database_configured"
  ],
  "additionalProperties": false
}
